# 记账助手 配置模板
# 复制本文件为 .env, 填入你的真实值(勿提交 .env 到git)
# .env 已被 .gitignore 忽略; 本 .env.example 可提交, 仅作配置说明。

# —— 微信测试号配置 ——
# 必填: 与微信测试号后台"接口配置信息"里填的 Token 完全一致, 否则签名校验不通过
WECHAT_TOKEN =
# 必填: 微信测试号信息里的 appsecret
WECHAT_SECRET =

# —— 推送口令 ——
# /push/* 手动触发接口的口令(与代码 PUSH_TOKEN 校验)
PUSH_TOKEN =

# —— Cloudflare Workers AI(可选, 用于真AI分析) ——
# 不需要真AI可留空, 会自动降级为本地文字总结
# Account ID(非敏感, 默认值已在config, 可留空)
CF_ACCOUNT_ID =
# 有 Workers AI 权限的 API Token(敏感, 在 Cloudflare My Profile→API Tokens 创建)
CF_API_TOKEN =

# —— MySQL(推荐, 用于PythonAnywhere部署) ——
# 填了下面四项就会自动用 MySQL(写入快); 全留空则回退 SQLite
# 在 PythonAnywhere → Databases 页创建数据库并设置密码后, 填入:
# 主机名(你的用户名+.mysql.pythonanywhere-services.com)
MYSQL_HOST =
# 数据库用户名(通常=你的PA用户名)
MYSQL_USER =
# 在 PA Databases 页设置/重置的密码(敏感)
MYSQL_PASSWORD =
# 数据库名(通常= 用户名$default, 如 ggglll77$default)
MYSQL_DB =
# MYSQL_PORT = 3306

# —— 可选: 覆盖config默认 ——
# LLM_API_KEY = on          # AI总开关(非空即启用)
# LLM_BASE_URL = ...
# LLM_MODEL = ...
# WECHAT_APPID = ...
# DAILY_TEMPLATE_ID = ...